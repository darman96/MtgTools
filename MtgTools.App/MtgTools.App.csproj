<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- UI artifact paths -->
    <UiDistRoot>$(MSBuildThisFileDirectory)..\MtgTools.Ui\.dist</UiDistRoot>
    <UiAppDist>$(UiDistRoot)\app</UiAppDist>
    <UiStorybook>$(UiDistRoot)\storybook</UiStorybook>
    <UiRootPath>$(MSBuildThisFileDirectory)..\MtgTools.Ui</UiRootPath>
  </PropertyGroup>

  <Target Name="CleanUiAssets" BeforeTargets="CopyUiAssets">
    <Message Text="Cleaning UI assets from output directory..." Importance="high" />
    <RemoveDir Directories="$(OutputPath)wwwroot" />
    <Message Text="UI assets clean completed" Importance="high" />
  </Target>
  
  <Target Name="CopyUiAssets" BeforeTargets="Build">
    <Message Text="Copying UI assets to output directory..." Importance="high" />
    <ItemGroup>
      <AppAssets Include="$(UiAppDist)\**\*" />
      <StorybookAssets Include="$(UiStorybook)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AppAssets)" DestinationFolder="$(OutputPath)wwwroot/app/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StorybookAssets)" DestinationFolder="$(OutputPath)wwwroot/storybook/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="UI assets copy completed" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ScryfallClient\ScryfallClient\ScryfallClient.Extensions.DependencyInjection\ScryfallClient.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\ScryfallClient\ScryfallClient\ScryfallClient\ScryfallClient.csproj" />
    <ProjectReference Include="..\MtgTools.Ui\MtgTools.Ui.csproj" />
    <ProjectReference Include="..\MtgTools.WebView\MtgTools.WebView.csproj" />
    <ProjectReference Include="..\..\photino.NET\Photino.NET\Photino.NET.csproj" />
  </ItemGroup>

</Project>
